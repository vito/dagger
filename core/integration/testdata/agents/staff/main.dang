type Staff {
  agent(base: LLM!): LLM! @agent {
    base.withSystemPrompt("Chief role.").withTools(currentNode.{{... on Dagger.Staff!}}.chief)
  }

  worker(base: LLM!, me: Agent!): LLM! {
    base.withSystemPrompt("Worker role: " + me.name).withTools(currentNode.{{... on Dagger.Staff!}}.peers)
  }

  chief: Chief! { Chief() }
  peers: Peers! { Peers() }
  notATransform: String! { "not a conversation" }
}

type Chief {
  chiefOnly: String! { "Chief capability." }

  hire(ws: Workspace!): String! @cache(policy: FunctionCachePolicy.Never) {
    let worker = llm(model: "__WORKER_MODEL__").withWorkspace(ws).spawn(name: "helper", expertise: ws.artifacts.filterUri("staff/worker").asExpertise.{{ id }}.map { node(id: _.id).{{ ... on Expertise! }} })
    "worker handle: " + worker.handle
  }
}

type Peers {
  """Original peer implementation."""
  parentName(me: Agent!): String! {
    let parent = me.parent
    if (parent == null) { raise "worker has no parent" }
    "original parent: " + parent.name
  }

  reload(llm: LLM!): LLM! {
    let entries = llm.expertise.{{ id }}.map { entry =>
      let uri = node(id: entry.id).{{ ... on Expertise! }}.artifact.uri
      let refreshed = llm.workspace.artifacts.filterUri(uri).asExpertise.{{ id }}
      let id = refreshed[0].id
      if (id == null) { raise "recorded entry is missing" }
      node(id: id).{{ ... on Expertise! }}
    }
    llm.recompose(expertise: entries)
  }
}
